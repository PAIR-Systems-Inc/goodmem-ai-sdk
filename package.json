{
  "name": "@pairsystems/goodmem-ai-sdk",
  "description": "GoodMem memory for the Vercel AI SDK: model-facing tools, a retrieval middleware and developer helpers, built on the official @pairsystems/goodmem SDK.",
  "keywords": [
    "ai",
    "ai-sdk",
    "vercel-ai-sdk",
    "goodmem",
    "memory",
    "rag",
    "retrieval-augmented-generation",
    "tools",
    "middleware",
    "llm"
  ],
  "version": "0.1.0",
  "type": "commonjs",
  "scripts": {
    "check": "tsc --noEmit",
    "compile": "tsup",
    "build:clean": "rimraf ./lib",
    "build": "npm-run-all build:clean check compile",
    "test": "tsx --test tests/goodmem_test.ts",
    "test:live": "tsx --test --test-concurrency=1 tests/goodmem_live_test.ts",
    "check:readme": "node scripts/check-readme.mjs --against lib",
    "capture-fixtures": "tsx scripts/capture-fixtures.ts"
  },
  "homepage": "https://github.com/PAIR-Systems-Inc/goodmem-ai-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PAIR-Systems-Inc/goodmem-ai-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/PAIR-Systems-Inc/goodmem-ai-sdk/issues"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@pairsystems/goodmem": "^0.1.9"
  },
  "peerDependencies": {
    "ai": "^6.0.0 || ^7.0.0",
    "zod": "^3.25.76 || ^4.1.8"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^2.0.80",
    "@types/node": "^20.19.43",
    "ai": "^7.0.123",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "zod": "^4.6.5"
  },
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "sideEffects": false,
  "publishConfig": {
    "provenance": true,
    "access": "public"
  }
}
